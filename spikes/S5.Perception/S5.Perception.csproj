<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>S5.Perception</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- WPF draws the numbered boxes over captures, and the selftest's window. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aldren.Spikes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- llama-server process handling is shared with the benchmark tool. -->
    <ProjectReference Include="..\..\tools\bench\Aldren.Bench.csproj" />
  </ItemGroup>

</Project>
