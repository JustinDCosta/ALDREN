<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CdpAttach</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Drives the installed Chrome only: no Playwright browsers are downloaded. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\testpage\index.html" Link="testpage\index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
