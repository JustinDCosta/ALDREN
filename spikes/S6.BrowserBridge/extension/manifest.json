{
  "manifest_version": 3,
  "name": "ALDREN bridge probe",
  "description": "Phase 0 test of ALDREN's browser bridge. Works only on the local test page.",
  "version": "0.1",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
