<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aldren.App.Expanded.ExpandedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aldren.App.Expanded"
    Title="ALDREN conversation">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- Your turn: right, in ALDREN's colours. -->
            <DataTemplate x:Key="UserTemplate" x:DataType="local:ConversationEntry">
                <StackPanel MaxWidth="340" HorizontalAlignment="Right" Spacing="3">
                    <Border
                        Padding="13,8,13,9"
                        HorizontalAlignment="Right"
                        Background="{StaticResource AldrenBrandBrush}"
                        CornerRadius="16,16,4,16">
                        <TextBlock
                            Foreground="{StaticResource AldrenOnBrandBrush}"
                            IsTextSelectionEnabled="True"
                            LineHeight="20"
                            Text="{x:Bind Text, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind Meta}" />
                </StackPanel>
            </DataTemplate>

            <!-- ALDREN's turn: left, with its mark. -->
            <DataTemplate x:Key="AssistantTemplate" x:DataType="local:ConversationEntry">
                <Grid MaxWidth="392" HorizontalAlignment="Left" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="20" Height="20" Margin="0,8,0,0" VerticalAlignment="Top">
                        <Ellipse Width="16" Height="16" Stroke="{StaticResource AldrenBrandBrush}" StrokeThickness="2.6" />
                        <Ellipse Width="4.6" Height="4.6" Fill="{StaticResource AldrenBrandBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <Border
                            MinHeight="37"
                            Padding="13,8,13,9"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16,16,16,4">
                            <Grid>
                                <TextBlock
                                    local:Linked.Text="{x:Bind Text, Mode=OneWay}"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="20"
                                    TextWrapping="Wrap" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Margin="6,2"
                                    Foreground="{StaticResource AldrenBrandBrush}"
                                    IsActive="{x:Bind Waiting, Mode=OneWay}"
                                    Visibility="{x:Bind Waiting, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Meta}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <local:EntryTemplateSelector
                x:Key="EntryTemplates"
                Assistant="{StaticResource AssistantTemplate}"
                User="{StaticResource UserTemplate}" />

            <Style x:Key="GhostButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <Style x:Key="SuggestionButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </Grid.Resources>

        <!-- Title bar: drag by the left part; the buttons sit outside the drag region. -->
        <Grid Height="46">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBar" Padding="16,0,0,0" Background="Transparent" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="20" VerticalAlignment="Center">
                    <Ellipse Width="17" Height="17" Stroke="{StaticResource AldrenBrandBrush}" StrokeThickness="2.8" />
                    <Ellipse Width="5" Height="5" Fill="{StaticResource AldrenBrandBrush}" />
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="ALDREN" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="NewButton"
                    AutomationProperties.Name="New conversation"
                    Click="OnNewClick"
                    Style="{StaticResource GhostButtonStyle}"
                    ToolTipService.ToolTip="New conversation (clears this one)">
                    <FontIcon FontSize="15" Glyph="&#xE710;" />
                </Button>
                <Button
                    AutomationProperties.Name="Open Settings"
                    Click="OnSettingsClick"
                    Style="{StaticResource GhostButtonStyle}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="15" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer
            x:Name="Scroll"
            Grid.Row="1"
            Padding="16,6,16,10"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="OnScrollViewChanged">
            <ItemsRepeater
                x:Name="Messages"
                AutomationProperties.Name="Conversation"
                ItemTemplate="{StaticResource EntryTemplates}"
                SizeChanged="OnMessagesSizeChanged">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Before the first message: what ALDREN is for, and a few things to try. -->
        <StackPanel
            x:Name="Empty"
            Grid.Row="1"
            MaxWidth="340"
            Margin="24,0"
            VerticalAlignment="Center"
            Spacing="8">
            <Grid Width="52" Height="52" Margin="0,0,0,6" HorizontalAlignment="Center">
                <Ellipse Width="46" Height="46" Stroke="{StaticResource AldrenBrandBrush}" StrokeThickness="7" />
                <Ellipse Width="13" Height="13" Fill="{StaticResource AldrenBrandBrush}" />
            </Grid>
            <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="What can I do for you, boss?" />
            <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Type below, or try one of these."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button Click="OnSuggestionClick" Content="What can you do?" Style="{StaticResource SuggestionButtonStyle}" />
            <Button Click="OnSuggestionClick" Content="What's on my to-do list?" Style="{StaticResource SuggestionButtonStyle}" />
            <Button Click="OnSuggestionClick" Content="Remind me in 10 minutes to stretch" Style="{StaticResource SuggestionButtonStyle}" />
            <Button Click="OnSuggestionClick" Content="Focus for 25 minutes on studying" Style="{StaticResource SuggestionButtonStyle}" />
        </StackPanel>

        <Grid Grid.Row="2" Padding="12,2,12,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button
                x:Name="StopSpeakingButton"
                HorizontalAlignment="Center"
                AutomationProperties.Name="Stop speaking"
                Click="OnStopSpeakingClick"
                CornerRadius="16"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="11" Glyph="&#xE71A;" />
                    <TextBlock Text="Stop speaking  (Esc)" />
                </StackPanel>
            </Button>

            <!-- The composer: one rounded shape holding the microphone, the field and send. -->
            <Grid
                Grid.Row="1"
                MinHeight="46"
                Padding="6,0,7,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="4"
                CornerRadius="23">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="MicButton"
                    Width="34"
                    Height="34"
                    Margin="0,0,0,5"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Talk to ALDREN"
                    Click="OnMicClick"
                    CornerRadius="17"
                    Style="{StaticResource GhostButtonStyle}"
                    ToolTipService.ToolTip="Talk (same as the push-to-talk hotkey)">
                    <FontIcon FontSize="15" Glyph="&#xE720;" />
                </Button>
                <TextBox
                    x:Name="Input"
                    Grid.Column="1"
                    Margin="2,12,2,12"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Message to ALDREN"
                    MaxHeight="120"
                    MaxLength="4000"
                    PlaceholderText="Message ALDREN"
                    PreviewKeyDown="OnInputPreviewKeyDown"
                    Style="{StaticResource AldrenBareTextBoxStyle}"
                    TextChanged="OnInputTextChanged"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="SendButton"
                    Grid.Column="2"
                    Margin="0,0,0,6"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Send"
                    Click="OnSendClick"
                    IsEnabled="False"
                    Style="{StaticResource AldrenBrandRoundButtonStyle}"
                    ToolTipService.ToolTip="Send (Enter)">
                    <FontIcon FontSize="13" FontWeight="Bold" Glyph="&#xE74A;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
