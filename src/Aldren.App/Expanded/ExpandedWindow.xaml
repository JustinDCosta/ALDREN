<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aldren.App.Expanded.ExpandedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ALDREN conversation">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            x:Name="StopSpeakingButton"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Stop speaking"
            Content="■  Stop speaking  (Esc)"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="Collapsed"
            Click="OnStopSpeakingClick" />

        <ListView
            Grid.Row="1"
            x:Name="Conversation"
            AutomationProperties.Name="Conversation"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Margin="0,4" Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="Input"
                AutomationProperties.Name="Message to ALDREN"
                PlaceholderText="Type a request, for example: what time is it"
                KeyDown="OnInputKeyDown" />
            <Button
                x:Name="SendButton"
                Grid.Column="1"
                AutomationProperties.Name="Send"
                Content="Send"
                Click="OnSendClick" />
        </Grid>
    </Grid>
</Window>
