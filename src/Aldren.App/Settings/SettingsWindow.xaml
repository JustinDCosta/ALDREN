<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Aldren.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ALDREN Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="44" Padding="16,0,0,0" Background="Transparent" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Ellipse Width="16" Height="16" Stroke="{StaticResource AldrenBrandBrush}" StrokeThickness="2.6" />
                <Ellipse Width="4.6" Height="4.6" Fill="{StaticResource AldrenBrandBrush}" />
            </Grid>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="ALDREN Settings" />
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            AutomationProperties.Name="Settings sections"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="256"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged">
            <ScrollViewer x:Name="Page" Padding="36,24,36,36" HorizontalScrollBarVisibility="Disabled" />
        </NavigationView>
    </Grid>
</Window>
