<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>aldren-bench</AssemblyName>
    <RootNamespace>Aldren.Bench</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Eval data shares the Eval folder with its code; only the data files go to the output. -->
    <None Include="Eval\*.jsonl;Eval\*.json;Eval\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
