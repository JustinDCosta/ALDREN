{
  "manifest_version": 3,
  "name": "ALDREN Companion",
  "description": "Lets ALDREN, your local assistant, read pages, click, fill forms, download and keep focus sessions, on your request.",
  "version": "0.7.0",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "downloads", "declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.js"], "matches": ["<all_urls>"] }],
  "action": { "default_title": "ALDREN Companion" }
}
